<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
		<ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
		<CompressionEnabled>false</CompressionEnabled>
		<LostSpawnsAot Condition="'$(LostSpawnsAot)' == ''">true</LostSpawnsAot>
		<RunAOTCompilation>$(LostSpawnsAot)</RunAOTCompilation>
		<WasmStripILAfterAOT>false</WasmStripILAfterAOT>
		<WasmDedup>false</WasmDedup>
		<PublishTrimmed>$(LostSpawnsAot)</PublishTrimmed>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.3" />
		<PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="SpawnDev.SpawnJS" Version="3.0.7" />
		<PackageReference Include="SpawnDev.SpawnJS.Blazor" Version="3.0.7" />
		<PackageReference Include="SpawnDev.SpawnJS.Cryptography" Version="2.1.1" />
		<PackageReference Include="SpawnDev.GameUI" Version="1.1.0" />
		<ProjectReference Include="../dependencies/SpawnDev.VoxelEngine/SpawnDev.VoxelEngine/SpawnDev.VoxelEngine.csproj" />
	</ItemGroup>

	<ItemGroup>
		<TrimmerRootAssembly Include="ILGPU" />
		<TrimmerRootAssembly Include="ILGPU.Algorithms" />
		<TrimmerRootAssembly Include="SpawnDev.ILGPU" />
		<TrimmerRootAssembly Include="SpawnDev.VoxelEngine" />
		<TrimmerRootAssembly Include="SpawnDev.GameUI" />
		<TrimmerRootAssembly Include="LostSpawns" />
	</ItemGroup>

	<ItemGroup>
		<ServiceWorker Include="wwwroot/service-worker.js" PublishedContent="wwwroot/service-worker.published.js" />
	</ItemGroup>

</Project>
